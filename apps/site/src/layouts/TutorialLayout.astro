---
import '../styles/fonts.css'
import '../styles/theme.css'
import { TUTORIAL } from '../tutorial/manifest.ts'
import HeadMeta from '../components/HeadMeta.astro'
interface Props {
  title: string
  activeId?: string
  description?: string
  path: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}
const { title, activeId, description, path, jsonLd } = Astro.props as Props
const base = import.meta.env.BASE_URL
const desc = description ?? 'A guided, hands-on tutorial — from blank canvas to a running graph. Each chapter builds on the previous one in the same xenolith.v1 JSON format.'
const nav = [
  { label: 'Learn',      href: `${base}/learn/` },
  { label: 'Docs',       href: `${base}/guides/install/` },
  { label: 'Examples',   href: `${base}/examples/` },
  { label: 'Playground', href: `${base}/playground/` },
  { label: 'GitHub',     href: 'https://github.com/XenolithEngine/xenolith-graph' },
]
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon-64.png`} />
    <HeadMeta title={title} description={desc} path={path} ogType="website" jsonLd={jsonLd} />
    <style is:global>
      html, body { margin: 0; background: #121212; color: #e8e8e8; font-family: var(--xn-sans, system-ui, sans-serif); }
      html, body { min-height: 100vh; }
      .tut-body { min-height: calc(100vh - 49px); }
      a { color: inherit; }
      .tut-header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 24px; padding: 12px 24px; background: rgba(18,18,18,.85); backdrop-filter: blur(10px); border-bottom: 1px solid #232323; }
      .tut-brand { font-family: var(--xn-display, var(--xn-sans)); font-weight: 600; letter-spacing: .04em; color: var(--xn-gold, #FCB400); text-decoration: none; font-size: 14px; }
      .tut-nav { display: flex; gap: 18px; }
      .tut-nav a { font-size: 14px; color: #b8b8b8; text-decoration: none; }
      .tut-nav a:hover, .tut-nav a[aria-current="page"] { color: #fff; }
      .tut-body { display: flex; align-items: flex-start; }
      .tut-side { position: sticky; top: 49px; align-self: flex-start; flex: 0 0 260px; width: 260px; max-height: calc(100vh - 49px); overflow-y: auto; padding: 20px 10px 60px 12px; border-right: 1px solid #1f1f1f; }
      .tut-side-home { display: block; font-weight: 600; font-size: 15px; text-decoration: none; color: #fff; padding: 6px 10px; border-radius: 8px; margin-bottom: 12px; }
      .tut-side-home.active { background: rgba(252,180,0,.14); color: var(--xn-gold, #FCB400); }
      .tut-side ol { list-style: none; counter-reset: chap; margin: 0; padding: 0; }
      .tut-side li { counter-increment: chap; margin: 1px 0; }
      .tut-side li a { display: flex; gap: 10px; align-items: baseline; font-size: 13.5px; color: #b0b0b0; text-decoration: none; padding: 8px 10px; border-radius: 7px; line-height: 1.35; }
      .tut-side li a::before { content: counter(chap, decimal-leading-zero); font: 11px var(--xn-mono, ui-monospace, monospace); color: #6a6a6a; flex: 0 0 22px; padding-top: 1px; }
      .tut-side li a:hover { color: #fff; background: #1c1c1c; }
      .tut-side li a.active { color: var(--xn-gold, #FCB400); background: rgba(252,180,0,.12); font-weight: 500; }
      .tut-side li a.active::before { color: var(--xn-gold, #FCB400); }
      .tut-main { flex: 1; min-width: 0; padding: 32px 28px 80px; max-width: 1080px; }
      @media (max-width: 820px) { .tut-side { display: none; } }
    </style>
  </head>
  <body>
    <header class="tut-header">
      <a class="tut-brand" href={base}>XENOLITHGRAPH</a>
      <nav class="tut-nav">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.label === 'Learn' ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <div class="tut-body">
      <aside class="tut-side">
        <a class={`tut-side-home${activeId ? '' : ' active'}`} href={`${base}/learn/`}>Learn</a>
        <ol>
          {TUTORIAL.map((c) => (
            <li><a class={c.id === activeId ? 'active' : ''} href={`${base}/learn/${c.id}/`}>{c.title}</a></li>
          ))}
        </ol>
      </aside>
      <main class="tut-main"><slot /></main>
    </div>
  </body>
</html>
