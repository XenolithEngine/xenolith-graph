---
import ExamplesLayout from '../../layouts/ExamplesLayout.astro'
import { EXAMPLES, CATEGORY_ORDER, FRAMEWORKS } from '../../examples/manifest.ts'
const base = import.meta.env.BASE_URL
const byCategory = CATEGORY_ORDER
  .map((cat) => ({ cat, items: EXAMPLES.filter((e) => e.category === cat) }))
  .filter((g) => g.items.length > 0)
const fwLabels = (e: (typeof EXAMPLES)[number]): string =>
  FRAMEWORKS.filter((f) => e.impls[f.key]).map((f) => f.label).join(' · ')
---
<ExamplesLayout
  title="Examples — XenolithGraph"
  path="/examples/"
  description="A live gallery of 30 self-contained examples: AI-driven MCP workflows, audio synth, image pipeline, visual debugger, time-travel, graph diff, stress test, theming, and more. Each demo runs in the browser — no setup."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'XenolithGraph Examples',
    description: '30 live examples demonstrating every feature of the editor.',
    url: 'https://xenolithengine.github.io/xenolith-graph/examples/',
  }}
>
  <h1 style="margin:0 0 6px;font-size:32px;">Examples</h1>
  <p style="margin:0 0 28px;color:#9a9a9a;max-width:60ch;">
    Live, interactive examples — each with a framework switcher, full source, and reset.
    Drag nodes, pull connections, edit widgets right in the preview.
  </p>

  <section style="margin-bottom:36px;">
    <h2 style="font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#7a7a7a;margin:0 0 14px;">Aspirational</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
      {/* Extra-large external demo — has its own layout, runtime + AssemblyScript codegen. We
          link out instead of squeezing into the standard `<DemoFrame>` per-id page. */}
      <a href={`${base}/wasm/`} class="ex-tile ex-tile-special">
        <div class="ex-thumb ex-thumb-wasm" aria-hidden="true">
          <span class="ex-badge">AS-WASM</span>
        </div>
        <div class="ex-tile-body">
          <strong>Mandelbrot — graph → AssemblyScript → WASM</strong>
          <span class="ex-tile-blurb">A graph that compiles itself to a WASM module via `@xenolith/runtime-as` — same node-graph runs at ~4 000× the baseline interpreter speed. The "what we're working toward" demo: visual editor + a real codegen runtime, end to end.</span>
          <span class="ex-tile-fw">Standalone SPA · separate layout</span>
        </div>
      </a>
    </div>
  </section>

  {byCategory.map((g) => (
    <section style="margin-bottom:36px;">
      <h2 style="font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#7a7a7a;margin:0 0 14px;">{g.cat}</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
        {g.items.map((e) => (
          <a href={`${base}/examples/${e.id}/`} class="ex-tile">
            <img class="ex-thumb" src={`${base}/examples/thumbs/${e.id}.jpg`} alt={e.title} loading="lazy" />

            <div class="ex-tile-body">
              <strong>{e.title}</strong>
              <span class="ex-tile-blurb">{e.blurb}</span>
              <span class="ex-tile-fw">{fwLabels(e)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <style>
    .ex-tile { display:flex; flex-direction:column; text-decoration:none; border:1px solid #262626; border-radius:12px; overflow:hidden; background:#181818; transition:border-color .15s, transform .15s; }
    .ex-tile:hover { border-color:#FCB400; transform:translateY(-2px); }
    .ex-thumb { display:block; width:100%; height:150px; object-fit:cover; background:radial-gradient(circle at 30% 30%, #1f1f1f, #121212); border-bottom:1px solid #262626; }
    .ex-tile-body { padding:12px 14px; display:flex; flex-direction:column; gap:6px; }
    .ex-tile-body strong { font-size:15px; color:#fff; }
    .ex-tile-blurb { font-size:12.5px; color:#9a9a9a; line-height:1.45; }
    .ex-tile-fw { font-size:11px; color:#6f6f6f; margin-top:2px; }
    /* Aspirational "Mandelbrot WASM" card — no thumb yet, generated badge + gradient instead. */
    .ex-tile-special { border-color: rgba(252, 180, 0, 0.35); }
    .ex-thumb-wasm {
      display: grid; place-items: center; height: 150px;
      background: radial-gradient(ellipse at 35% 30%, #2a1d05 0%, #0f0f0f 70%);
      border-bottom: 1px solid #2a2a2a;
    }
    .ex-badge {
      font: 600 11px/1 'JetBrains Mono', ui-monospace, monospace;
      letter-spacing: .12em; text-transform: uppercase;
      color: #FCB400;
      border: 1px solid rgba(252, 180, 0, 0.55);
      padding: 5px 10px; border-radius: 6px;
      background: rgba(252, 180, 0, 0.08);
    }
  </style>
</ExamplesLayout>
