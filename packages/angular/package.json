{
  "name": "@xenolithengine/graph-angular",
  "version": "0.7.0-beta.4",
  "description": "Angular adapter for XenolithGraph — standalone <xenolith-graph> component (consumed from source).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xenolithengine/graph-adapter-core": "workspace:*",
    "@xenolithengine/graph-editor": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "pixi.js": "^8.6.0",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@angular/core": "^17.0.0",
    "jsdom": "^25.0.0",
    "pixi.js": "^8.6.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "angular",
    "node-editor",
    "node-graph",
    "graph-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XenolithEngine/xenolith-graph.git",
    "directory": "packages/angular"
  },
  "homepage": "https://graph.xenolith.studio/",
  "bugs": {
    "url": "https://github.com/XenolithEngine/xenolith-graph/issues"
  },
  "author": "XenolithEngine"
}
