{
  "name": "@xenolithengine/graph-theme-xen",
  "version": "0.7.0-beta.2",
  "description": "Xen — the default original design system for XenolithGraph. Dark / gold palette with typed pins, categorical headers, and glassmorphic effects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenolithengine/graph-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "xenolith",
    "theme",
    "design-system",
    "node-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XenolithEngine/xenolith-graph.git",
    "directory": "packages/theme-xen"
  },
  "homepage": "https://xenolithengine.github.io/xenolith-graph/",
  "bugs": {
    "url": "https://github.com/XenolithEngine/xenolith-graph/issues"
  },
  "author": "XenolithEngine"
}
