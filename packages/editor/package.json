{
  "name": "@xenolithengine/graph-editor",
  "version": "0.7.0-beta.4",
  "description": "XenolithGraph editor — composes core, renderer, interaction, and plugins.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenolithengine/graph-core": "workspace:*",
    "@xenolithengine/graph-render-pixi": "workspace:*",
    "@xenolithengine/graph-theme-xen": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "pixi.js": "^8.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "node-editor",
    "node-graph",
    "graph-editor",
    "blueprint",
    "flow-editor",
    "react-flow-alternative",
    "mcp",
    "ai-agents",
    "pixi",
    "webgl",
    "comfyui",
    "langflow",
    "visual-programming",
    "dataflow",
    "shader-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XenolithEngine/xenolith-graph.git",
    "directory": "packages/editor"
  },
  "homepage": "https://graph.xenolith.studio/",
  "bugs": {
    "url": "https://github.com/XenolithEngine/xenolith-graph/issues"
  },
  "author": "XenolithEngine"
}
