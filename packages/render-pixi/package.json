{
  "name": "@xenolithengine/render-pixi",
  "version": "0.7.0-beta.0",
  "description": "PIXI v8 renderer for XenolithGraph. PIXI is a peer dependency.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenolithengine/core": "workspace:*",
    "@xenolithengine/theme-xen": "workspace:*"
  },
  "peerDependencies": {
    "@xenolithengine/theme-xen": "workspace:*",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "pixi.js": "^8.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "node-editor",
    "webgl",
    "pixi",
    "pixijs",
    "renderer",
    "graph-renderer"
  ],
  "publishConfig": {
    "access": "public"
  }
}
