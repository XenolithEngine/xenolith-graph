{
  "name": "@xenolithengine/graph-svelte",
  "version": "0.7.0-beta.8",
  "description": "Svelte adapter for XenolithGraph — the use:xenolith action, reactive stores, in-editor panel components, svelteWidget.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components.ts",
      "svelte": "./src/components.ts",
      "default": "./src/components.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -b --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenolithengine/graph-adapter-core": "workspace:*",
    "@xenolithengine/graph-editor": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0",
    "svelte": ">=4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "jsdom": "^25.0.0",
    "pixi.js": "^8.6.0",
    "svelte": "^5.55.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "node-editor",
    "node-graph",
    "graph-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XenolithEngine/xenolith-graph.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://graph.xenolith.studio/",
  "bugs": {
    "url": "https://github.com/XenolithEngine/xenolith-graph/issues"
  },
  "author": "XenolithEngine",
  "svelte": "./src/index.ts"
}
