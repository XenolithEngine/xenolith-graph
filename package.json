{
  "name": "xenolith-graph",
  "private": true,
  "version": "0.7.0-beta.3",
  "type": "module",
  "description": "Open-source embeddable node-graph editor with a polished, opinionated design system (Xen) out of the box.",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "playground": "pnpm --filter @xenolithengine/playground dev",
    "changeset": "changeset",
    "release": "changeset publish",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "size-limit": "^11.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0"
  }
}
